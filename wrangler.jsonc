{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algebra-games",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  // Workers AI for the chat page; the free plan includes a daily allowance
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // the relay and the API must reach the Worker before the static files
    "run_worker_first": ["/wsproxy/*", "/api/*"]
  }
}
