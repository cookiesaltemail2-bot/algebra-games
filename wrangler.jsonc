{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algebra-games",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // the relay must reach the Worker before the static files
    "run_worker_first": ["/wsproxy/*"]
  }
}
